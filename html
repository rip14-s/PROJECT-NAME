
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Record Management System</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #1e293b;
    padding: 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

header {
    background: #1e3a8a;
    color: white;
    padding: 30px;
    text-align: center;
    border-radius: 12px;
    margin-bottom: 25px;
}

header p {
    margin-top: 10px;
    color: #dbeafe;
}

h2 {
    margin: 25px 0 15px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
}

.card {
    background: white;
    padding: 22px;
    border-radius: 10px;
    box-shadow: 0 2px 8px #00000010;
}

.card h3 {
    color: #64748b;
    font-size: 14px;
}

.card p {
    font-size: 27px;
    font-weight: bold;
    margin-top: 10px;
    color: #1d4ed8;
}

.section {
    background: white;
    padding: 22px;
    border-radius: 10px;
    margin-top: 22px;
    box-shadow: 0 2px 8px #00000010;
}

.controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 15px;
}

input, button {
    padding: 11px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 14px;
}

input {
    flex: 1;
    min-width: 130px;
}

button {
    background: #2563eb;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background: #1e40af;
}

.delete {
    background: #dc2626;
}

.delete:hover {
    background: #991b1b;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #eff6ff;
    color: #1e3a8a;
}

tr:hover {
    background: #f8fafc;
}

.table-wrapper {
    overflow-x: auto;
}

.message {
    margin-top: 12px;
    color: #15803d;
    font-weight: bold;
}

footer {
    text-align: center;
    margin-top: 30px;
    color: #64748b;
}

@media(max-width: 600px) {
    body {
        padding: 12px;
    }

    header {
        padding: 22px 10px;
    }
}
</style>
</head>

<body>

<div class="container">

<header>
    <h1>Student Record Management System</h1>
    <p>Database Management System Project | MySQL Concept</p>
</header>

<h2>Dashboard</h2>

<div class="cards">
    <div class="card">
        <h3>Total Students</h3>
        <p id="total">0</p>
    </div>

    <div class="card">
        <h3>Average Marks</h3>
        <p id="average">0</p>
    </div>

    <div class="card">
        <h3>Highest Marks</h3>
        <p id="highest">0</p>
    </div>

    <div class="card">
        <h3>Lowest Marks</h3>
        <p id="lowest">0</p>
    </div>
</div>

<div class="section">
    <h2>Student Records</h2>

    <div class="controls">
        <input type="text" id="search"
        placeholder="Search student name..."
        oninput="displayStudents()">
    </div>

    <div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Department</th>
                <th>Semester</th>
                <th>Marks</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="studentTable"></tbody>
    </table>
    </div>
</div>

<div class="section">
    <h2>Add New Student</h2>

    <div class="controls">
        <input type="number" id="newId" placeholder="Student ID">
        <input type="text" id="newName" placeholder="Student Name">
        <input type="text" id="newDepartment" placeholder="Department">
        <input type="number" id="newSemester" placeholder="Semester">
        <input type="number" id="newMarks" placeholder="Marks">
        <button onclick="addStudent()">Add Student</button>
    </div>

    <p class="message" id="message"></p>
</div>

<div class="section">
    <h2>Update Student Marks</h2>

    <div class="controls">
        <input type="number" id="updateId" placeholder="Student ID">
        <input type="number" id="updateMarks" placeholder="New Marks">
        <button onclick="updateStudent()">Update Marks</button>
    </div>
</div>

<div class="section">
    <h2>Department-wise Student Count</h2>

    <div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>Department</th>
                <th>Total Students</th>
            </tr>
        </thead>
        <tbody id="departmentTable"></tbody>
    </table>
    </div>
</div>

<footer>
    <p>Student Record Management System | DBMS Project</p>
</footer>

</div>

<script>

// Initial Student Records

let students = [
    {id:1, name:"Ripa", department:"CSE", semester:3, marks:85},
    {id:2, name:"Samira", department:"CSE", semester:2, marks:78},
    {id:3, name:"Rahim", department:"EEE", semester:4, marks:82},
    {id:4, name:"Nusrat", department:"CSE", semester:3, marks:91},
    {id:5, name:"Tanvir", department:"BBA", semester:5, marks:74},
    {id:6, name:"Sadia", department:"CSE", semester:2, marks:88},
    {id:7, name:"Fahim", department:"EEE", semester:3, marks:69},
    {id:8, name:"Mim", department:"BBA", semester:4, marks:80},
    {id:9, name:"Arif", department:"CSE", semester:5, marks:95},
    {id:10, name:"Jannat", department:"EEE", semester:2, marks:76}
];

// Display Student Records

function displayStudents() {

    let search = document.getElementById("search")
        .value.toLowerCase();

    let filtered = students.filter(student =>
        student.name.toLowerCase().includes(search)
    );

    let output = "";

    filtered.forEach(student => {
        output += `
        <tr>
            <td>${student.id}</td>
            <td>${student.name}</td>
            <td>${student.department}</td>
            <td>${student.semester}</td>
            <td>${student.marks}</td>
            <td>
                <button class="delete"
                onclick="deleteStudent(${student.id})">
                Delete
                </button>
            </td>
        </tr>`;
    });

    document.getElementById("studentTable").innerHTML =
        output || "<tr><td colspan='6'>No students found</td></tr>";

    updateStatistics();
}

// Add Student

function addStudent() {

    let id = Number(document.getElementById("newId").value);
    let name = document.getElementById("newName").value.trim();
    let department = document.getElementById("newDepartment").value.trim().toUpperCase();
    let semester = Number(document.getElementById("newSemester").value);
    let marks = Number(document.getElementById("newMarks").value);

    if (!id || !name || !department ||
        !semester || !document.getElementById("newMarks").value ||
        marks < 0 || marks > 100 || semester < 1 ||
        students.some(s => s.id === id)) {

        alert("Enter valid details. Student ID must be unique.");
        return;
    }

    students.push({id, name, department, semester, marks});

    document.querySelectorAll(
        "#newId, #newName, #newDepartment, #newSemester, #newMarks"
    ).forEach(input => input.value = "");

    document.getElementById("message").innerText =
        "Student added successfully!";

    displayStudents();
}

// Update Student Marks

function updateStudent() {

    let id = Number(document.getElementById("updateId").value);
    let marksInput = document.getElementById("updateMarks");
    let marks = Number(marksInput.value);

    let student = students.find(s => s.id === id);

    if (!student || marksInput.value === "" ||
        marks < 0 || marks > 100) {
        alert("Enter a valid student ID and marks (0-100).");
        return;
    }

    student.marks = marks;

    document.getElementById("updateId").value = "";
    marksInput.value = "";

    displayStudents();

    alert("Student marks updated successfully!");
}

// Delete Student

function deleteStudent(id) {

    if (confirm("Are you sure you want to delete this student?")) {

        students = students.filter(student => student.id !== id);

        displayStudents();
    }
}

// Aggregate Functions

function updateStatistics() {

    let total = students.length;

    let sum = students.reduce((acc, s) => acc + s.marks, 0);

    let average = total ? (sum / total).toFixed(2) : 0;

    let highest = total ? Math.max(...students.map(s => s.marks)) : 0;

    let lowest = total ? Math.min(...students.map(s => s.marks)) : 0;

    document.getElementById("total").innerText = total;
    document.getElementById("average").innerText = average;
    document.getElementById("highest").innerText = highest;
    document.getElementById("lowest").innerText = lowest;

    // Department-wise COUNT and GROUP BY

    let departments = {};

    students.forEach(student => {
        departments[student.department] =
            (departments[student.department] || 0) + 1;
    });

    let departmentOutput = "";

    for (let department in departments) {
        departmentOutput += `
        <tr>
            <td>${department}</td>
            <td>${departments[department]}</td>
        </tr>`;
    }

    document.getElementById("departmentTable").innerHTML =
        departmentOutput;
}

// Initial Display

displayStudents();

</script>

</body>
</html>
